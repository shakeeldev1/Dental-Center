# =============================================================================
# Expert Dental Center CRM — Frontend environment
# Copy to `.env`. Only PUBLIC values belong here (Vite exposes VITE_* to the
# browser). NEVER put the service-role key or WhatsApp secrets here.
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the NestJS backend API
VITE_API_BASE_URL=http://localhost:3000/api
